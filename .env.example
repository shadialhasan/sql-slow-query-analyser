# MySQL / MariaDB Slow Query Analyser Configuration

# Path to slow query log file
SLOW_LOG_PATH=/var/log/mysql/mysql-slow.log

# Threshold Filtering Configurations
MIN_QUERY_TIME=1.0
MIN_ROWS_EXAMINED=1000
TOP_N=10

# Export Defaults (optional: table, json, csv)
EXPORT_FORMAT=json
EXPORT_PATH=slow_queries_report.json
